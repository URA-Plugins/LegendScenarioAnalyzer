<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsUraPlugin>true</IsUraPlugin>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
		<!-- 自动把本插件的 NuGet 依赖闭包(CsvHelper 及其传递依赖)拷到输出 -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<PluginInternalName>LegendScenarioAnalyzer</PluginInternalName>
		<PluginDisplayName>解析传奇杯回合信息</PluginDisplayName>
		<PluginAuthor>UmaAi Team</PluginAuthor>
		<PluginDescription>解析传奇杯回合信息</PluginDescription>
		<PluginRepositoryUrl>https://github.com/URA-Plugins/LegendScenarioAnalyzer</PluginRepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="LegendScenarioAnalyzerSmoke" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.0.1" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="i18n\Game.Designer.cs">
			<DependentUpon>Game.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="i18n\Game.resx">
			<LastGenOutput>Game.Designer.cs</LastGenOutput>
			<Generator>ResXFileCodeGenerator</Generator>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
	</ItemGroup>

</Project>
